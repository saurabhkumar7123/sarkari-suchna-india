PORT=3000
# `npm start` sets NODE_ENV=production automatically. For local dev use `npm run dev`.
NODE_ENV=development

# Canonical site URL for sitemap.xml (npm run sitemap)
SITE_URL=https://www.example.com

# 1 = trust first proxy (NGINX / load balancer) for correct client IP in logs & rate limits
TRUST_PROXY=0
# Leave empty (or set 0.0.0.0) for LAN/mobile access in local environment.
BIND_HOST=0.0.0.0

JWT_SECRET=change_me_to_strong_random_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
MAX_ACTIVE_SESSIONS_PER_USER=10
LOGIN_FAILURE_DELAY_MS=400
ADMIN_USER=admin
ADMIN_PASS_HASH=replace_with_bcrypt_hash

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Legacy alias (optional): if set and DB_PASSWORD is empty, DB_PASS is used.
DB_PASS=
DB_NAME=jobportal
# Connection pool size (tune per CPU/RAM)
DB_POOL_LIMIT=20
DB_CONNECT_TIMEOUT_MS=10000
# How long to cache DB ping result for /ready & requireDb (ms)
DB_HEALTH_CACHE_MS=3000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Comma-separated origins (no spaces after comma recommended).
# Include local network origins when testing from phones/laptops on LAN.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000,http://10.0.0.10:3000

# Cookie domain is optional and should be set only in production.
COOKIE_DOMAIN=
PRODUCTION_COOKIE_DOMAIN=

# Rate limits (15 min window unless RATE_LIMIT_WINDOW_MS set)
RATE_LIMIT_WINDOW_MS=900000
# Balanced production defaults (per client IP)
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=15000
RATE_LIMIT_API_MAX=3000
RATE_LIMIT_API_BURST_MAX=12000
RATE_LIMIT_API_STRICT_MAX=60
RATE_LIMIT_ADMIN_API_MAX=200
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ADMIN_SENSITIVE_MAX=60

# API cache TTLs (seconds)
CACHE_PAGES_LIST_TTL=60
CACHE_PAGE_DETAIL_TTL=120
CACHE_FINDER_TTL=120
CACHE_USE_MEMORY_FALLBACK=false

# Logging
LOG_LEVEL=info
ACCESS_LOG_SLOW_MS=3000
CSP_UPGRADE_INSECURE_REQUESTS=0

# PM2 (optional): fixed instance count instead of max
# PM2_INSTANCES=4

# Automated site update checker (5-10 minutes)
UPDATE_CHECK_INTERVAL_MINUTES=10
UPDATE_MIN_TITLE_LENGTH=8
UPDATE_ALERT_COOLDOWN_MINUTES=10
UPDATE_RETENTION_DAYS=30
UPDATE_HIGH_PRIORITY_VALUE=2
UPDATE_MAX_ITEMS_PER_SITE=5
UPDATE_WORKER_CONCURRENCY=5
HEAVY_TASK_WORKER_CONCURRENCY=2

# Scheduler leadership / lock settings
SCHEDULER_LOCK_KEY=lock:update-scheduler
SCHEDULER_LOCK_TTL_SECONDS=600
QUEUE_WAITING_ALERT_THRESHOLD=50
QUEUE_ALERT_COOLDOWN_MINUTES=15
QUEUE_ALERT_LOCK_KEY=lock:queue-backlog-telegram-alert

# Finder API memory guardrails
FINDER_BATCH_SIZE=1000
FINDER_MAX_ROWS=200000

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis auth (optional if Redis has password enabled)
REDIS_PASSWORD=

# Optional AI parser integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
