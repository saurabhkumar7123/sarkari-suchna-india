PORT=3000
# `npm start` sets NODE_ENV=production automatically. For local dev use `npm run dev`.
NODE_ENV=development

# Canonical site URL for sitemap.xml (npm run sitemap)
SITE_URL=https://www.example.com

# 1 = trust first proxy (NGINX / load balancer) for correct client IP in logs & rate limits
TRUST_PROXY=0
# Leave empty (or set 0.0.0.0) for LAN/mobile access in local environment.
BIND_HOST=0.0.0.0

JWT_SECRET=change_me_to_strong_random_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
MAX_ACTIVE_SESSIONS_PER_USER=10
LOGIN_FAILURE_DELAY_MS=400
ADMIN_USER=admin
# bcrypt hash — local: password 123456 → node -e "require('bcrypt').hash('123456',10).then(console.log)"
ADMIN_PASS_HASH=replace_with_bcrypt_hash
# Local only: /login auto sign-in without typing (ignored on live site). Set 0 to use the form.
# ADMIN_DEV_AUTO_LOGIN=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Legacy alias (optional): if set and DB_PASSWORD is empty, DB_PASS is used.
DB_PASS=
DB_NAME=jobportal
# Connection pool size (tune per CPU/RAM)
DB_POOL_LIMIT=20
DB_CONNECT_TIMEOUT_MS=10000
# How long to cache DB ping result for /ready & requireDb (ms)
DB_HEALTH_CACHE_MS=3000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Comma-separated origins (no spaces after comma recommended).
# Include local network origins when testing from phones/laptops on LAN.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000,http://10.0.0.10:3000

# Cookie domain is optional and should be set only in production.
COOKIE_DOMAIN=
PRODUCTION_COOKIE_DOMAIN=

# Rate limits (15 min window unless RATE_LIMIT_WINDOW_MS set)
RATE_LIMIT_WINDOW_MS=900000
# Balanced production defaults (per client IP)
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=15000
RATE_LIMIT_API_MAX=3000
RATE_LIMIT_API_BURST_MAX=12000
RATE_LIMIT_API_STRICT_MAX=15
RATE_LIMIT_AI_PARSE_MAX=15
RATE_LIMIT_PREVIEW_PAGE_MAX=20
RATE_LIMIT_ADMIN_API_MAX=200
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ADMIN_SENSITIVE_MAX=60

# API cache TTLs (seconds)
CACHE_PAGES_LIST_TTL=60
CACHE_PAGE_DETAIL_TTL=120
CACHE_FINDER_TTL=120
CACHE_RELATED_TTL=120
CACHE_HOME_TAXONOMY_TTL=120
CACHE_USE_MEMORY_FALLBACK=false

# Related jobs: set RELATED_JOBS_LEGACY=1 to restore old slug!= LIMIT query
# RELATED_JOBS_LEGACY=0
# RELATED_CANDIDATE_POOL=150

# Page views (job pages only; Redis cooldown recommended)
PAGE_VIEWS_ENABLED=1
PAGE_VIEW_COOLDOWN_SEC=1800

# Related click analytics (batched JSON file)
# RELATED_ANALYTICS_MAX=8000
# RELATED_ANALYTICS_FLUSH_MS=5000

# Logging
LOG_LEVEL=info
ACCESS_LOG_SLOW_MS=3000
CSP_UPGRADE_INSECURE_REQUESTS=0

# PM2 (optional): fixed instance count instead of max
# PM2_INSTANCES=4
# PM2_APP_NAME=sarkari-suchna-india

# Automated site update checker (5-10 minutes)
UPDATE_CHECK_INTERVAL_MINUTES=10
UPDATE_MIN_TITLE_LENGTH=8
UPDATE_ALERT_COOLDOWN_MINUTES=10
UPDATE_RETENTION_DAYS=30
UPDATE_HIGH_PRIORITY_VALUE=2
UPDATE_MAX_ITEMS_PER_SITE=5
UPDATE_WORKER_CONCURRENCY=5
HEAVY_TASK_WORKER_CONCURRENCY=2

# Scheduler leadership / lock settings
SCHEDULER_LOCK_KEY=lock:update-scheduler
SCHEDULER_LOCK_TTL_SECONDS=600
QUEUE_WAITING_ALERT_THRESHOLD=50
QUEUE_ALERT_COOLDOWN_MINUTES=15
QUEUE_ALERT_LOCK_KEY=lock:queue-backlog-telegram-alert

# Finder API memory guardrails
FINDER_BATCH_SIZE=1000
FINDER_MAX_ROWS=200000

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 1 only when testing Telegram on deploy (off by default — avoids restart spam)
# TELEGRAM_STARTUP_TEST=0

# Redis auth (optional if Redis has password enabled)
REDIS_PASSWORD=

# Optional AI parser integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safe CSV content import (queue only — does not publish pages)
CONTENT_IMPORT_ENABLED=1
# Structured CSV (import_group, section, line) → compile to canonical [Section: …] at import. 0 = legacy content column only.
# CONTENT_IMPORT_STRUCTURED=1
# Phase 2: quoted CSV / Indian amounts (1,30,093) in tables — off by default for backward compatibility
# TABLE_PARSER_V2=0
# Enable on staging first: TABLE_PARSER_V2=1
# Phase 3: mixed text + ---table--- blocks in one section (off by default)
# MIXED_SECTION_BLOCKS=0
# Enable on staging: MIXED_SECTION_BLOCKS=1
# Display capitalization for Latin text at render time (off by default)
# DISPLAY_TEXT_CAPITALIZE=0
# Enable on staging: DISPLAY_TEXT_CAPITALIZE=1
# Rollback: set to 1 to restore legacy CSV → generated/jobs/*.html behavior
CSV_LEGACY_STATIC_HTML=0
# CONTENT_IMPORT_MAX_ROWS=200
# CONTENT_IMPORT_MAX_CONTENT_CHARS=500000
# CONTENT_IMPORT_MAX_FILE_BYTES=5242880

# Generator drafts (admin parked drafts)
# GENERATOR_DRAFTS_ENABLED=1

# Local file-store paths (defaults under server/data or data/)
# CONTENT_REVIEW_METADATA_PATH=
# EDITORIAL_REVIEW_STORE_PATH=
# RECRUITMENT_OPS_METADATA_PATH=
# SHARED_PREVIEW_STORE_PATH=

# Sitemap / discovery
# SITEMAP_CHUNK_SIZE=5000
# TRENDING_RECENT_DAYS=14

# SSC update checker: prefer API feed when available
# SSC_USE_API=1

# Local-only PDF extract auth bypass (never enable in production)
# PDF_EXTRACT_SKIP_AUTH=0

# Recruitment Lifecycle feature flags (all default off — enable per rollout phase)
# Group A: Recruitment Data Presence
# RECRUITMENT_LIFECYCLE_DATA_PRESENCE_ENABLED=0
# Group B: Recruitment Read Awareness
# RECRUITMENT_LIFECYCLE_READ_AWARENESS_ENABLED=0
# Group C: Editorial Attachment
# RECRUITMENT_LIFECYCLE_EDITORIAL_ATTACHMENT_ENABLED=0
# Group D: Monitoring Matching
# RECRUITMENT_LIFECYCLE_MONITORING_MATCH_ENABLED=0
# Group E: Public Lifecycle
# RECRUITMENT_LIFECYCLE_PUBLIC_LIFECYCLE_ENABLED=0

# Recruitment detection pipeline (Phase 24 — default off)
# When enabled, runtime results are also kept in an in-memory preview buffer
# (Phase 30 — max 100 entries, no DB / review-queue writes).
# Preview buffer is process-local (see docs/recruitment-runtime-preview.md).
# RECRUITMENT_PIPELINE_ENABLED=0

# AMP-4A controlled production integration.
# All production automation paths must remain dormant until an explicit later package.
RECRUITMENT_PIPELINE_ENABLED=0
AUTO_DRAFT_ENABLED=0
AUTO_PUBLISH_ENABLED=0
TELEGRAM_DELIVERY_ENABLED=0
LIVE_CRAWLER_ENABLED=0
NOTIFICATION_GATEWAY_ENABLED=0
PRODUCTION_MONITORING_ENABLED=0
SCHEDULER_ACTIVATION_ENABLED=0
WORKER_ACTIVATION_ENABLED=0
CRON_ACTIVATION_ENABLED=0
