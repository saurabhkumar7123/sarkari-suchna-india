# AMP-4B staging activation template (NO SECRETS).
# Copy to .env.staging ONLY on a dedicated isolated staging host.
# DO NOT copy these enabled values into production .env without controlled rollout.
# NEVER commit .env.staging (gitignored).
#
# Runtime note: server/server.js and siteWorker currently load `.env` via dotenv.
# On a dedicated staging host, either:
#   - provision the host with `.env` populated from this template, OR
#   - point dotenv at `.env.staging` via process env / deploy wrapper.
# Local developer machines are NOT a dedicated staging host.
#
# `npm start` / production defaults must remain dormant (see .env.example).
# AUTO_PUBLISH_ENABLED MUST ALWAYS stay false.

NODE_ENV=staging
PORT=3001
BIND_HOST=127.0.0.1
SITE_URL=https://staging.example.invalid
TRUST_PROXY=1

# --- Isolated staging database (REQUIRED — never reuse production DB_NAME) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=jobportal_staging
DB_POOL_LIMIT=10

# --- Isolated staging Redis / BullMQ (REQUIRED — never share prod queues) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional queue prefix if supported by deploy conventions:
# BULLMQ_PREFIX=ssi-staging

# --- Minimum AMP-4B path (staging only) ---
PRODUCTION_MONITORING_ENABLED=true
SCHEDULER_ACTIVATION_ENABLED=true
WORKER_ACTIVATION_ENABLED=true
LIVE_CRAWLER_ENABLED=true
RECRUITMENT_PIPELINE_ENABLED=true
AUTO_DRAFT_ENABLED=true
NOTIFICATION_GATEWAY_ENABLED=true
TELEGRAM_DELIVERY_ENABLED=true

# Absolute safety — never enable auto-publish
AUTO_PUBLISH_ENABLED=false
CRON_ACTIVATION_ENABLED=false

# Fill from staging secret store — never commit real values
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dedicated enterprise file-store fallback path (if SQL migration not yet applied)
ENTERPRISE_DATA_DIR=./server/data/enterprise-staging

# PM2 naming hint for operators (ecosystem.config.js has no env_staging today;
# use a separate host or separate PM2 app name on that host — do not reload production):
# PM2_APP_NAME=sarkari-suchna-staging
