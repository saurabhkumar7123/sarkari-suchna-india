{
  "name": "ai-page-generator",
  "version": "1.0.0",
  "main": "server/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server/server.js",
    "dev": "cross-env NODE_ENV=development node --watch server/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "migrate:placeholders": "node server/scripts/migrate-placeholders.js",
    "sitemap": "node scripts/sitemap.js",
    "regenerate:jobs": "node scripts/regenerate-all-jobs.js",
    "load:test": "node scripts/load-test.js",
    "pm2:start": "cross-env PM2_TARGET_ENV=production pm2 start ecosystem.config.js --env production",
    "pm2:reload": "cross-env PM2_TARGET_ENV=production pm2 reload ecosystem.config.js --env production",
    "pm2:start:dev": "cross-env PM2_TARGET_ENV=development pm2 start ecosystem.config.js --env development",
    "pm2:stop": "pm2 stop sarkari-suchna",
    "pm2:restart": "pm2 restart sarkari-suchna"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.0",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "csurf": "^1.11.0",
    "csv-parser": "^3.2.0",
    "dompurify": "^3.4.0",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "fuse.js": "^7.3.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.17.2",
    "node-cache": "^5.1.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0",
    "tesseract.js": "^7.0.0",
    "winston": "^3.19.0"
  },
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "csurf": {
      "cookie": "^0.7.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.2",
    "supertest": "^7.2.2"
  }
}
